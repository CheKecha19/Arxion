# Виртуальные окружения и Python-кэш
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache-*/
.pytest-tmp-*/
.hypothesis/

# Тесты не публикуются в репозитории
# tests are maintained source

# Артефакты сборки и отчёты
build/
!harness/build
dist/
*.egg-info/
artifacts/
reports/

# Локальные данные и чувствительные конфигурации
data/
output/
*.env
.env
.env.*
*.cfg
*.conf
*.acl
*.backup

# Среда разработки
.vscode/
.idea/

# Disposable local outputs
/_temp_files/
